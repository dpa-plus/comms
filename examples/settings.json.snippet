{
  "_comment": "Merge this `hooks` block into ~/.claude/settings.json, or just run `comms-graph doctor --fix`, which does it for you and keeps a timestamped backup.",
  "_comment_shape": "Note the NESTED `hooks` array inside each entry. A flat {matcher, type, command} does not match the settings schema and is silently ignored: the hook simply never runs.",
  "_comment_path": "Use the absolute path of your comms-graph (`which comms-graph`) so the hook works from any directory.",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "/Users/YOU/.local/bin/comms-graph hook session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "/Users/YOU/.local/bin/comms-graph hook pre-edit" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "/Users/YOU/.local/bin/comms-graph hook session-end" }
        ]
      }
    ]
  }
}
