<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Run the `comms-graph ui` board as a macOS login service.

  RunAtLoad + KeepAlive: it starts at login and is restarted if it exits, so
  http://127.0.0.1:7878 is always up. `comms-graph doctor` (see its help) can write
  this file for you with the right path; this template is for doing it by hand.

  Set ProgramArguments[0] to your comms-graph (`which comms-graph`).

  After upgrading, `comms-graph doctor` with its fix flag restarts the job when the board
  reports an older version than the install.

  COMMS_ACTOR identifies YOU, the operator, so the board's write actions
  (Release, Remove/retire, End session) are enabled. Without it the board is
  read-only. Change it to your own operator name (e.g. human-jane); the generic
  names eli/claude/codex/agent/user are rejected.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>plus.dpa.comms-ui</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOU/.local/bin/comms-graph</string>
        <string>ui</string>
        <string>--no-open</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>COMMS_ACTOR</key>
        <string>operator</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/tmp/comms-ui.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/comms-ui.log</string>
</dict>
</plist>
